# =====================================================================
# docker/.env - ค่าตั้งค่าและรหัสผ่านของ stack (ห้าม commit ไฟล์ .env จริงเข้า git)
# =====================================================================
#
# ไฟล์นี้คือ "แม่แบบ" ไฟล์จริงคือ docker/.env
#   สร้างอัตโนมัติ:  ./scripts/init-env.sh   (login เว็บ = admin/admin, สุ่มรหัส OpenSearch + secret, chmod 600)
#   หรือทำเอง   :  copy ไฟล์นี้เป็น docker/.env แล้วแก้ทุกค่าที่เป็น CHANGE_ME
#
# ใครอ่านไฟล์นี้
#   docker compose (อ่านอัตโนมัติเพราะอยู่โฟลเดอร์เดียวกับ docker-compose.yml)
#     -> central-api   : CENTRAL_*, OPENSEARCH_ADMIN_PASSWORD, PROMETHEUS_URL
#     -> opensearch    : OPENSEARCH_INITIAL_ADMIN_PASSWORD
#     -> otel          : OPENSEARCH_ADMIN_PASSWORD (ใช้ใน start_push_log/otel/otelcol.yaml)
#     -> compose เอง   : COMPOSE_PROFILES (เลือกว่าจะรันบริการกลุ่มไหน)
#   scripts/preflight.sh ตรวจว่ายังเหลือ CHANGE_ME หรือไม่
# =====================================================================

# --- เลือกว่าจะใช้ Prometheus ตัวไหน ---------------------------------
# bundled-prometheus  = รัน Prometheus + node-exporter ใน stack นี้
# (ว่าง)              = ใช้ Prometheus ที่มีอยู่แล้วบน server
# เพิ่ม ",cadvisor"   = รัน cAdvisor ด้วย (ใช้สิทธิ์ privileged ปิดไว้เป็นค่าเริ่มต้น)
COMPOSE_PROFILES=bundled-prometheus

# โหมด bundled: ปล่อย 3 บรรทัดนี้ตามเดิม
# โหมด external: PROMETHEUS_URL=http://host.docker.internal:9090
#                CENTRAL_NODE_JOB / CENTRAL_NODE_INSTANCE = label ที่ Prometheus ของคุณ
#                ใช้กับ node_exporter ของ server นี้ เช่น node / 10.0.10.5:9100
PROMETHEUS_URL=http://prometheus:9090
# พอร์ตบน host ของ Prometheus ที่มากับ stack (ชนกับ Prometheus ตัวอื่นบนเครื่อง -> เปลี่ยนเป็น 9091)
PROMETHEUS_HOST_PORT=9090
# อายุ metrics ใน Prometheus ที่มากับ stack (หน้า Logs แสดงเฉพาะ log ที่มี metrics -> log เก่ากว่านี้จะไม่แสดง)
# เปลี่ยนแล้วรัน: cd docker && docker compose up -d prometheus
PROMETHEUS_RETENTION=7d
# หน้าเว็บ: 127.0.0.1 = เปิดได้เฉพาะในเครื่อง (ปลอดภัย, ใช้คู่กับ nginx/SSH tunnel) | 0.0.0.0 = เปิดจากเครื่องอื่นได้
CENTRAL_WEB_BIND=127.0.0.1
CENTRAL_WEB_PORT=8090
CENTRAL_NODE_JOB=central
CENTRAL_NODE_INSTANCE=node-exporter:9100

# --- รหัสเข้าหน้าเว็บ (web_dashboard/backend/auth.py) ------------------
# ค่าเริ่มต้น admin / admin  (อยากเปลี่ยน: แก้สองบรรทัดนี้ แล้วรัน
#   cd docker && docker compose up -d --force-recreate central-api)
CENTRAL_AUTH_USERNAME=admin
CENTRAL_AUTH_PASSWORD=admin
# ใช้เซ็น session cookie: สุ่ม 64 ตัวอักษร  ->  openssl rand -hex 32
CENTRAL_SECRET_KEY=CHANGE_ME
# เปลี่ยนเป็น true เมื่อเข้าเว็บผ่าน HTTPS
CENTRAL_COOKIE_SECURE=false
# (ไม่บังคับ) จำกัด IP ที่ใช้ key นี้เข้าเครื่อง target ได้: ใส่ IP ของ server กลาง เช่น 10.0.0.5
# หน้า Settings จะใส่ from="..." หน้า public key ให้ตอนวาง key (ว่าง = ไม่จำกัด; puller อยู่หลัง Docker NAT ใส่ผิดจะเข้าไม่ได้)
CENTRAL_KEY_FROM=

# --- OpenSearch -------------------------------------------------------
# ต้องมีตัวพิมพ์ใหญ่ + เล็ก + ตัวเลข + อักขระพิเศษ ยาวอย่างน้อย 8
# สองค่านี้ต้องเหมือนกัน รหัสผ่านถูกกำหนดตอนสร้าง volume opensearch-data ครั้งแรก
# การเปลี่ยนภายหลังต้องทำมือ (ดู docs/INSTALL-TH.md)
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME

# อายุ log ใน OpenSearch ก่อนถูกลบอัตโนมัติ (ISM policy)  รูปแบบ 90m / 12h / 7d
# เปลี่ยนค่าแล้วรัน: bash install.sh --keep   (ใช้กับ index ใหม่ ส่วน index เดิมใช้ค่าเดิมจนครบอายุ)
OPENSEARCH_LOG_RETENTION=7d

# --- เจ้าของไฟล์บน host -------------------------------------------------
# container ของ puller / buffer-cleaner / central-api รันด้วย uid:gid นี้ (ไม่ใช่ root)
# ไฟล์ใน data/ และ config/ จึงเป็นของ user บนเครื่อง ไม่เกิด permission denied
# init-env.sh / install.sh ตั้งให้อัตโนมัติ (ค่าของ user ที่รัน) -> ดูด้วย: id -u ; id -g
HOST_UID=1000
HOST_GID=1000

# --- agent บนเครื่อง Windows (Fluent Bit) -> central-agent-gw ---------------------
# token ที่ agent ต้องส่งมา (install.sh สร้างให้อัตโนมัติ) เปลี่ยนแล้วต้องติดตั้ง agent ใหม่ทุกเครื่อง
CENTRAL_AGENT_TOKEN=
# พอร์ตรับข้อมูลจาก agent (HTTPS)  ไม่มีเครื่อง Windows: CENTRAL_AGENT_BIND=127.0.0.1
CENTRAL_AGENT_BIND=0.0.0.0
CENTRAL_AGENT_PORT=4318
# พอร์ตติดตั้ง agent แบบคำสั่งบรรทัดเดียว (central-agent-enroll HTTPS)  ปิด: CENTRAL_ENROLL_BIND=127.0.0.1
CENTRAL_ENROLL_PORT=4319
