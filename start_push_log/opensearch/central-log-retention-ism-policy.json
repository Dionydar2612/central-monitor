{
  "policy": {
    "description": "Delete central log indices after OPENSEARCH_LOG_RETENTION (docker/.env, default 7d); value applied by scripts/apply-ism.py",
    "ism_template": [
      {
        "index_patterns": [
          "logs-central-*"
        ],
        "priority": 100
      }
    ],
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "7d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ]
  }
}
